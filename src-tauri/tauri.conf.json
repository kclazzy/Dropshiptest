{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dropship",
  "version": "0.1.0",
  "identifier": "app.dropship.local",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [{ "title": "Dropship", "width": 1100, "height": 720, "minWidth": 800, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
