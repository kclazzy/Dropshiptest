{
  "manifest_version": 3,
  "name": "Dropship Local Bridge",
  "version": "0.1.0",
  "description": "Связывает браузер с локальным приложением Dropship: импорт товаров и сессия поставщика.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "optional_permissions": ["cookies"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Dropship", "default_popup": "popup.html" }
}
